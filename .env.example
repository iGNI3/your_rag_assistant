# Frontend (Vercel -> Project Settings -> Environment Variables)
# Replace with your live Render backend URL (no trailing slash)
VITE_API_BASE_URL=https://clayrag-backend.onrender.com
# Enable HttpOnly cookie auth once ALLOWED_ORIGINS is restricted to your exact Vercel URL
# VITE_USE_COOKIE_AUTH=true

# Backend (Render -> Environment Variables)
# Comma-separated frontend origins allowed by CORS (never leave '*' in production)
# ALLOWED_ORIGINS=https://your-app.vercel.app
# High-entropy secret for encrypting user API keys at rest in pipeline_config
# CLAYRAG_ENCRYPTION_KEY=replace-with-32-byte-random-secret
# Keep false in production to prevent creating default demo admin credentials
# ENABLE_DEMO_USER=false
# Session lifetime in days (default: 7)
# SESSION_TTL_DAYS=7
# Maximum single upload size in MB (default: 25)
# MAX_UPLOAD_MB=25
